# Copy this file to `.env` next to docker-compose.yml and fill in real
# values. Never commit the real `.env` — it holds production secrets.
#
#   cp .env.prod.example .env

# --- Domains -----------------------------------------------------------
# No reverse proxy is bundled in this compose stack — api and web each
# EXPOSE port 3000 and are meant to be fronted by the platform's own proxy.
# On Coolify: open this resource, give the `api` service and the `web`
# service each their own domain under their Domains tab (Coolify's built-in
# Traefik then handles routing + automatic HTTPS per service — no ACME
# email or cert config needed here). Paste those two assigned (or your own
# custom) domains below, full scheme included:
PUBLIC_APP_URL=https://your-web-domain.example.com
PUBLIC_API_URL=https://your-api-domain.example.com

# Required — CORS_ORIGIN and ORIGIN below derive from these, and with no
# reverse-proxy fallback in this file, an unset value means a broken deploy
# (CORS blocking every request / adapter-node resolving bad URLs), not a
# silently-wrong one.
#
# Note: Coolify also shows its own SERVICE_FQDN_<SERVICE>/SERVICE_URL_<SERVICE>
# variables (one pair per service with a domain assigned in its Domains tab —
# e.g. SERVICE_URL_WEB, SERVICE_URL_API). Those are auto-managed by Coolify
# itself, not read by this app — you don't need to set them, just copy the
# same domain values into PUBLIC_APP_URL/PUBLIC_API_URL above.

# --- Database --------------------------------------------------------------
POSTGRES_USER=medicore
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=medicore_hr

# --- API secrets -------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-64-hex-chars

# Optional — defaults shown. ACCESS is the short-lived Bearer token the web
# app attaches to every request; REFRESH is the hard cap on how long a
# session can be silently renewed before the officer must sign in again.
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=8h

# Must be exactly 32 bytes as 64 hex chars. Generate with: openssl rand -hex 32
# Losing/rotating this key makes existing encrypted nationalId/bank-detail
# fields unreadable — back it up somewhere safe outside this server.
ENCRYPTION_KEY=change-me-64-hex-chars

# Set to "false" after the very first successful boot against a fresh
# database (auto-migrate/seed only needs to run once).
AUTO_MIGRATE=true
