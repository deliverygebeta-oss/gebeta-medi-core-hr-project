DATABASE_URL=postgres://medicore:medicore@localhost:5433/medicore_hr
PORT=3000

# HS256 signing secret for the Bearer access token — must be at least 32 characters.
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters
# Short-lived access token (attached to every request) and the longer-lived
# refresh token (the actual session — see apps/api/src/auth.ts).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=8h

# AES-256-GCM key for encrypting national ID / bank account / pension / TIN
# at rest. Must be exactly 64 hex characters (32 bytes).
#   generate one with: openssl rand -hex 32
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

NODE_ENV=development

# Browser origin(s) allowed to call this API (comma-separated). The web app
# runs on a different domain in production, so this must list its real URL —
# see .env.prod.example / docker-compose.yml (PUBLIC_APP_URL). Defaults to
# the local Vite dev server.
CORS_ORIGIN=http://localhost:5173

# Set to "false" to disable the automatic migrate+seed that normally runs on
# every server boot — recommended once you're running against a shared or
# production database, so migrations only happen via a deliberate
# `bun run db:migrate` step.
AUTO_MIGRATE=true
